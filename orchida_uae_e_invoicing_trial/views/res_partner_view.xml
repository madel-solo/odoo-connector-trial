<odoo>
    <record id="view_partner_einvoice_form" model="ir.ui.view">
        <field name="name">res.partner.form.custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="E-Invoice Info" name="einv_info">
                    <group>
                        <group>
                            <field name="trn_tin"/>
                            <field name="buyer_endpoint_id"/>
                            <field name="cfg_buyer_scheme_id"/>
                            <field name="cfg_buyer_tax_scheme"/>
                        </group>
                        <group>
                            <field name="cfg_buyer_agency_id"/>
                            <field name="cfg_buyer_agency_name"/>
                            <field name="orchida_payment_instruction"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_tree_custom" model="ir.ui.view">
        <field name="name">res.partner.tree.custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="trn_tin"/>
                <field name="buyer_endpoint_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_einv_customer_list" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
            (ref('view_res_partner_tree_custom'), 'list'),
            (ref('view_partner_einvoice_form'), 'form')
        ]"/>
        <field name="domain">[('customer_rank', '&gt;', 0)]</field>
    </record>
</odoo>
