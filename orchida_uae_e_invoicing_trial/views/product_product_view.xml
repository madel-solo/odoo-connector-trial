<odoo>
    <record id="view_product_product_orchida_einvoice" model="ir.ui.view">
        <field name="name">product.product.form.orchida.einvoice</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="orchida_standard_id"/>
                <field name="orchida_rcm_data_status" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
