<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_orchida_einvoice" model="ir.ui.view">
        <field name="name">account.journal.form.orchida.einvoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="orchida_submit_einvoice"
                         invisible="type != 'sale'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_tree_orchida_einvoice" model="ir.ui.view">
        <field name="name">account.journal.tree.orchida.einvoice</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="orchida_submit_einvoice" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
