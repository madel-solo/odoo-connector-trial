<odoo>
    <record id="view_res_config_settings_einvoice_tab" model="ir.ui.view">
        <field name="name">res.config.settings.einvoice.tab</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="E-Invoice" string="E-Invoice" name="orchida_e_invoice" groups="account.group_account_manager">
                    <block title="Orchida E-Invoice" name="orchida_e_invoice_settings">
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 o_setting_box">
                                <div class="o_setting_left_pane"><field name="orchida_connector_enabled" widget="boolean_toggle"/></div>
                                <div class="pl-3 ps-3">
                                    <label for="orchida_connector_enabled"/>
                                    <div class="text-muted">Master switch. When off, the connector is disabled and invoices post normally without any e-invoicing checks, submissions, or status jobs.</div>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="api_token" class="col-3 col-lg-3 o_form_label"/>
                                    <field name="api_token" password="True" class="oe_inline"/>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="companyid" class="col-3 col-lg-3 o_form_label"/>
                                    <field name="companyid" password="True" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane"/>
                                <div class="o_setting_right_pane">
                                    <label for="URL_Orchida" class="col-3 col-lg-3 o_form_label"/>
                                    <field name="URL_Orchida" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                        <div class="row mt16 o_settings_container">
                            <div class="col-12 o_setting_box">
                                <div class="o_setting_left_pane"><field name="orchida_auto_submit_einvoice"/></div>
                                <div class="o_setting_right_pane">
                                    <label for="orchida_auto_submit_einvoice"/>
                                    <div class="text-muted">Disable to post invoices first and send them manually later.</div>
                                </div>
                            </div>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
