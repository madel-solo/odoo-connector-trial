<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_orchida_document_ac_wizard_form" model="ir.ui.view">
        <field name="name">orchida.document.ac.wizard.form</field>
        <field name="model">orchida.document.ac.wizard</field>
        <field name="arch" type="xml">
            <form string="Document Allowance / Charge">
                <sheet>
                    <!-- Type badge header -->
                    <div class="oe_title mb-3">
                        <h1>
                            <span invisible="indicator != 'allowance'" class="badge bg-primary">Allowance</span>
                            <span invisible="indicator != 'charge'" class="badge bg-warning text-dark">Charge</span>
                        </h1>
                    </div>
                    <group>
                        <field name="move_id" invisible="1"/>
                        <field name="indicator" invisible="1"/>
                        <group string="Type &amp; Amount">
                            <field name="amount" default_focus="1"/>
                            <field name="tax_id" required="1"/>
                        </group>
                        <group string="Reason">
                            <field name="allowance_reason_code" invisible="indicator != 'allowance'" required="indicator == 'allowance'"/>
                            <field name="charge_reason_code" invisible="indicator != 'charge'" required="indicator == 'charge'"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
