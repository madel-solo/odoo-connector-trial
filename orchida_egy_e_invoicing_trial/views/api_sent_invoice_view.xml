<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Search view -->
    <record id="view_api_sent_invoice_search" model="ir.ui.view">
        <field name="name">api.sent.invoice.search</field>
        <field name="model">api.sent.invoice</field>
        <field name="arch" type="xml">
            <search string="Search E-Invoice Submissions">
                <field name="move_name"/>
                <field name="partner_id"/>
                <field name="move_id"/>
                <field name="orchida_tax_status"/>
                <field name="orchida_receiver_status"/>
                <field name="outcome" string="Status"/>
                <field name="failure_type" optional="hide"/>
                <field name="source"/>
                <separator/>
                <filter string="Both Valid" name="both_valid" domain="[('orchida_tax_status', '=', 'valid'), ('orchida_receiver_status', '=', 'valid')]"/>
                <filter string="Any Invalid" name="any_invalid" domain="['|', ('orchida_tax_status', 'ilike', 'invalid'), ('orchida_receiver_status', 'ilike', 'invalid')]"/>
                <filter string="Both Pending" name="both_pending" domain="[('orchida_tax_status', '=', 'pending'), ('orchida_receiver_status', '=', 'pending')]"/>
                <filter string="Processing" name="unknown" domain="[('outcome', '=', 'unknown')]"/>
                <separator/>
                <filter string="Invoices" name="invoices" domain="[('move_type', 'in', ('out_invoice', 'in_invoice'))]"/>
                <filter string="Credit Notes" name="credit_notes" domain="[('move_type', 'in', ('out_refund', 'in_refund'))]"/>
                <separator/>
                <group name="group_by">
                    <filter string="Tax Status" name="group_tax" context="{'group_by': 'orchida_tax_status'}"/>
                    <filter string="Receiver Status" name="group_rec" context="{'group_by': 'orchida_receiver_status'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Sent Date" name="group_date" context="{'group_by': 'sent_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_api_sent_invoice_tree" model="ir.ui.view">
        <field name="name">api.sent.invoice.tree</field>
        <field name="model">api.sent.invoice</field>
        <field name="arch" type="xml">
            <list string="E-Invoice Submissions"
                  decoration-danger="overall_status == 'invalid'"
                  decoration-success="overall_status == 'valid'"
                  decoration-muted="overall_status == 'pending'"
                  multi_edit="0">
                <field name="overall_status" invisible="1"/>
                <field name="failure_type" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="move_name" readonly="1" optional="show" widget="open_move_widget"/>
                <field name="partner_id" readonly="1" optional="show"/>
                <field name="amount_total" readonly="1" optional="show"/>
                <field name="currency_id" readonly="1" optional="hide" groups="base.group_multi_currency"/>
                <field name="move_type" readonly="1" optional="hide"/>
                <field name="sent_date" readonly="1" optional="show"/>
                <field name="source" readonly="1" optional="show"/>
                <field name="outcome" readonly="1" optional="show"/>
                <field name="http_status" readonly="1" optional="hide"/>
                <field name="attempt_count" readonly="1" optional="hide"/>
                <field name="last_sync" readonly="1" optional="hide"/>
                <field name="orchida_tax_status" readonly="1" optional="show"/>
                <field name="orchida_receiver_status" readonly="1" optional="show"/>
                <field name="response_short" readonly="1" optional="show" class="text-danger fw-bold"/>
                <button name="action_check_status" type="object" string="Check Status" icon="fa-refresh" class="btn-link" title="Check status from API" groups="account.group_account_user" invisible="outcome != 'unknown' or not company_id.orchida_connector_enabled"/>
                <button name="action_correct_invoice" type="object" string="Correct Invoice" icon="fa-pencil" class="btn-link" title="Open invoice for correction" groups="account.group_account_user" invisible="failure_type != 'document' or not company_id.orchida_connector_enabled"/>
                <button name="action_retry_submission" type="object" string="Retry" icon="fa-paper-plane" class="btn-link" title="Retry submission" groups="account.group_account_user" invisible="outcome == 'valid' or failure_type == 'document' or not company_id.orchida_connector_enabled"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_api_sent_invoice_form" model="ir.ui.view">
        <field name="name">api.sent.invoice.form</field>
        <field name="model">api.sent.invoice</field>
        <field name="arch" type="xml">
            <form string="E-Invoice Submission">
                <field name="company_id" invisible="1"/>
                <header>
                    <button name="action_check_status" type="object" string="Check Status" class="btn-secondary" groups="account.group_account_user" invisible="outcome != 'unknown' or not company_id.orchida_connector_enabled"/>
                    <button name="action_correct_invoice" type="object" string="Correct Invoice" class="btn-primary" groups="account.group_account_user" invisible="failure_type != 'document' or not company_id.orchida_connector_enabled"/>
                    <button name="action_retry_submission" type="object" string="Retry Submission" class="btn-primary" groups="account.group_account_user" invisible="outcome == 'valid' or failure_type == 'document' or not company_id.orchida_connector_enabled"/>
                </header>
                <sheet>
                    <!-- Status header -->
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="move_name" readonly="1"/>
                            <span invisible="orchida_tax_status != 'valid' or orchida_receiver_status != 'valid'" class="badge bg-success ms-2">Valid</span>
                            <span invisible="orchida_tax_status not in ('invalid', 'rejected') and orchida_receiver_status not in ('invalid', 'rejected')" class="badge bg-danger ms-2">Invalid</span>
                            <span invisible="orchida_tax_status != 'pending' or orchida_receiver_status != 'pending'" class="badge bg-warning text-dark ms-2">Pending</span>
                        </h1>
                    </div>

                    <group>
                        <group string="Invoice Details">
                            <field name="move_id" readonly="1" options="{'no_open': False}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="currency_id" readonly="1" groups="base.group_multi_currency"/>
                            <field name="move_type" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Submission Status">
                            <field name="sent_date" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                            <field name="orchida_tax_status" readonly="1"/>
                            <field name="orchida_receiver_status" readonly="1"/>
                            <field name="success" readonly="1"/>
                            <field name="outcome" string="Status" readonly="1"/>
                            <field name="failure_type" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="internal_code" readonly="1"/>
                            <field name="http_status" readonly="1"/>
                            <field name="attempt_count" readonly="1"/>
                            <field name="api_uuid" string="Invoice UUID" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Error Details" name="error_details" invisible="orchida_tax_status not in ('invalid', 'rejected') and orchida_receiver_status not in ('invalid', 'rejected')">
                            <group>
                                <field name="response_short" readonly="1" class="text-danger fw-bold"/>
                            </group>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_open_submission_history" type="object" string="Submission History" class="btn-secondary"/>
                        <button name="action_view_technical_details" type="object" string="Technical Details" class="btn-secondary" groups="account.group_account_user"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_api_sent_invoice_technical_form" model="ir.ui.view">
        <field name="name">api.sent.invoice.technical.form</field>
        <field name="model">api.sent.invoice</field>
        <field name="arch" type="xml">
            <form string="Technical Details" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="request_payload" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        <field name="response" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        <field name="status_response" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server actions -->
    <record id="server_action_resend_invoice" model="ir.actions.server">
        <field name="name">Resend Invoice to API</field>
        <field name="model_id" ref="model_api_sent_invoice"/>
        <field name="binding_model_id" ref="model_api_sent_invoice"/>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="state">code</field>
        <field name="code">
            records.resend_invoice_to_api()
        </field>
    </record>

    <record id="action_api_sent_invoice" model="ir.actions.act_window">
        <field name="name">E-Invoice Submissions</field>
        <field name="res_model">api.sent.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_api_sent_invoice_search"/>
    </record>

    <!-- Auto-refresh cron for pending invoices -->
    <record id="ir_cron_refresh_pending_invoice_status" model="ir.cron">
        <field name="name">Refresh Pending Invoice API Status</field>
        <field name="model_id" ref="model_api_sent_invoice"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_pending_status()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
