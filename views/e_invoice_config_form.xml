<odoo>
    <record id="view_res_config_settings_einvoice_tab" model="ir.ui.view">
        <field name="name">res.config.settings.einvoice.tab</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='account']" position="after">
                <div class="app_settings_block" data-string="E-Invoice" string="E-Invoice" data-key="orchida_e_invoice">
                    <h2>Orchida-E-Invoice</h2>

                        <div class="row mt16 o_settings_container">
                            <div class="col-12 o_setting_box">
                                <div class="o_setting_left_pane"><field name="orchida_connector_enabled" widget="boolean_toggle"/></div>
                                <div class="pl-3 ps-3">
                                    <label for="orchida_connector_enabled"/>
                                    <div class="text-muted">Master switch. When off, the connector is disabled and invoices post normally without any e-invoicing checks, submissions, or status jobs.</div>
                                </div>
                            </div>
                        </div>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"><label for="api_token"/></div>
                            <div class="o_setting_right_pane" style="margin-left: 60px;"><field name="api_token" password="True"/></div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"><label for="companyid"/></div>
                            <div class="o_setting_right_pane" style="margin-left: 60px;"><field name="companyid" password="True"/></div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"><label for="URL_Orchida"/></div>
                            <div class="o_setting_right_pane" style="margin-left: 60px;"><field name="URL_Orchida"/></div>
                        </div>
                    </div>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"><field name="orchida_auto_submit_einvoice"/></div>
                            <div class="o_setting_right_pane">
                                <label for="orchida_auto_submit_einvoice"/>
                                <div class="text-muted">Disable to post invoices first and send them manually later.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
